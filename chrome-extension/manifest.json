{
  "manifest_version": 3,
  "name": "Dyslexia Mode Toggle",
  "version": "1.0.0",
  "description": "Toggle OpenDyslexic font on any page for dyslexia-friendly reading.",
  "permissions": ["scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
  {
    "resources": ["fonts/*.otf"],
    "matches": ["<all_urls>"]
  }
]
}
